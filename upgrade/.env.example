# Copy to upgrade/.env (gitignored). Never commit real owner passwords.
# If OWNER_EMAIL and OWNER_PASSWORD are unset, local dev uses:
#   demo@example.com / demo-password
# Production (NODE_ENV=production) refuses that demo password.

PORT=4317
OWNER_EMAIL=demo@example.com
OWNER_PASSWORD=demo-password

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Optional. Defaults to upgrade/data.db
# UPGRADE_DB=upgrade/data.db
